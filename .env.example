# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/comment_db
SQLALCHEMY_DATABASE_URI=postgresql://postgres:your_password@localhost:5432/comment_db
SQLALCHEMY_TRACK_MODIFICATIONS=false
SQLALCHEMY_ECHO=true

# Redis Configuration
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET_KEY=your_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Environment
ENVIRONMENT=development

# ML Model Configuration
MODEL_NAME=phobert
MODEL_VERSION=1.0.0
MODEL_TYPE=transformer
MODEL_DIR=app/ml/h5_safetensors

# Social Media API Configuration (Optional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
MAX_BATCH_SIZE=100

# Monitoring & Logging
LOG_LEVEL=INFO
ENABLE_METRICS=true

# Docker Configuration
DOCKER_POSTGRES_DB=comment_db
DOCKER_POSTGRES_USER=postgres
DOCKER_POSTGRES_PASSWORD=your_secure_password
DOCKER_POSTGRES_PORT=5432

DOCKER_REDIS_PORT=6379

API_PORT=8000 